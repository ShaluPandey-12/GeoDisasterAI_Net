# ============================================================
#  GeoDisasterAINet — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ---------- Virtual Environments ----------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
conda-env/

# ---------- Jupyter Notebooks ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.nbconvert.ipynb

# ---------- Trained Models (large files — use Git LFS or Releases) ----------
Models/*.h5
Models/*.pkl
Models/*.joblib
*.h5
*.pkl
*.joblib
*.model

# ---------- Dataset & Images ----------
dataset/
data/
static/results/uploads/*
static/results/gradcam/*
static/results/heatmaps/*
static/results/lime/*
!static/results/uploads/.gitkeep
!static/results/gradcam/.gitkeep
!static/results/heatmaps/.gitkeep
!static/results/lime/.gitkeep

# ---------- SQLite Database ----------
*.db
*.sqlite3

# ---------- Flask / Web ----------
instance/
.webassets-cache
flask_session/

# ---------- Environment Variables ----------
.env
.env.local
.env.*.local
secrets.py
config_local.py

# ---------- OS Files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------- Testing ----------
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---------- Logs ----------
*.log
logs/
pip-log.txt

# ---------- Misc ----------
*.zip
*.rar
*.tar.gz
.cache/
